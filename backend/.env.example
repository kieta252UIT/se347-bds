# Spring Boot không tự đọc .env: cấu hình các biến này trong terminal/IDE.
# PostgreSQL ứng dụng, không dùng tài khoản Auth/anon key làm mật khẩu DB.
DB_URL=jdbc:postgresql://127.0.0.1:5432/se214
DB_USERNAME=se214_runtime
DB_PASSWORD=

# Mặc định Flyway chạy khi khởi động. Cung cấp user sở hữu schema riêng.
# Có thể migrate trước rồi đặt FLYWAY_ENABLED=false khi chạy runtime ít quyền.
FLYWAY_ENABLED=true
FLYWAY_DB_URL=jdbc:postgresql://127.0.0.1:5432/se214
FLYWAY_DB_USERNAME=se214_migrator
FLYWAY_DB_PASSWORD=

# Chỉ dùng DB test riêng; không trỏ về DB ứng dụng hoặc Supabase dùng chung.
DB_TEST_URL=jdbc:postgresql://127.0.0.1:55439/se214_migration_test
DB_TEST_USERNAME=postgres
DB_TEST_PASSWORD=
ALLOW_TEST_SCHEMA_RESET=false

# Các cấu hình Auth/HTTPS đang có của backend.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
FRONTEND_ORIGIN=https://localhost
